---
import Layout from "@/layouts/Layout.astro";
import ThemeMenu from "@/components/ThemeMenu";
import { getSources, getSummary } from "@/lib/data";
import { licenceShort } from "@/lib/sangkap";

type Current = "home" | "evidence" | "data" | "compounds";
type Props = { title: string; description?: string; current?: Current };
const { title, description, current } = Astro.props;
const [summary, { sources }] = await Promise.all([getSummary(), getSources()]);

const links: { id: Current; label: string; href: string }[] = [
  { id: "home", label: "Overview", href: "/sangkap/" },
  { id: "evidence", label: "Evidence", href: "/sangkap/evidence/" },
  { id: "data", label: "About the data", href: "/sangkap/data/" },
];
const family = [
  { name: "Timpla", href: "/timpla/", line: "Manila's cafés" },
  { name: "Sinturon", href: "/sinturon/", line: "the bean belt" },
  { name: "Pigâ", line: "soon" },
  { name: "Sangkap", href: "/sangkap/", line: "what's in a cup", here: true },
];
---

<Layout title={`${title} · Sangkap`} description={description}>
  <header class="horizon flex flex-wrap items-center gap-x-6 gap-y-1 border-b border-border pt-4 pb-3 print:hidden">
    <a href="/sangkap/" class="flex min-h-11 items-center gap-2.5 font-heading text-2xl font-bold tracking-[-0.03em]" aria-label="Sangkap, overview">
      <!-- Sangkap's mark: a white cup with a saucer line on the rose rounded square -->
      <svg width="28" height="28" viewBox="0 0 52 52" aria-hidden="true">
        <rect x="2" y="2" width="48" height="48" rx="14" fill="#8f3a5c"></rect>
        <path d="M14 18h20v10a10 10 0 0 1-20 0z" fill="none" stroke="#fff" stroke-width="2.4" stroke-linejoin="round"></path>
        <path d="M34 21h3a4 4 0 0 1 0 8h-3" fill="none" stroke="#fff" stroke-width="2.4"></path>
        <line x1="12" x2="36" y1="41" y2="41" stroke="#fff" stroke-width="2.4" stroke-linecap="round"></line>
      </svg>
      Sangkap
    </a>
    <nav aria-label="Sangkap" class="order-3 w-full sm:order-none sm:w-auto">
      <ul class="flex list-none flex-wrap gap-x-5 p-0 text-[15px] font-medium text-muted-foreground">
        {
          links.map((l) => (
            <li>
              <a
                href={l.href}
                aria-current={current === l.id ? "page" : undefined}
                class="inline-flex min-h-11 items-center hover:text-foreground aria-[current=page]:text-foreground aria-[current=page]:underline aria-[current=page]:decoration-primary-strong aria-[current=page]:decoration-2 aria-[current=page]:underline-offset-8"
              >
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="ml-auto flex items-center gap-3">
      <a href="/" class="hidden min-h-11 items-center font-mono text-xs text-muted-foreground hover:text-foreground sm:inline-flex">a side project by Ivanka Mendoza ↗</a>
      <ThemeMenu client:load />
    </div>
  </header>
  <slot />
  <aside class="band mt-12 flex flex-wrap items-baseline gap-x-3 gap-y-1 text-[13.5px]" aria-label="Not medical advice">
    <strong class="font-bold">Not medical advice.</strong>
    <span>Every number links to its source.</span>
  </aside>
  <footer class="mt-14 grid gap-3 border-t border-border pt-4 text-[13px] text-muted-foreground">
    <nav aria-label="Coffee, four ways" class="flex flex-wrap items-center gap-x-5">
      <span class="label-mono">Coffee, four ways</span>
      {
        family.map((f) =>
          f.href ? (
            <a href={f.href} aria-current={f.here ? "page" : undefined} class:list={["inline-flex min-h-11 items-center", f.here ? "font-semibold text-foreground" : "hover:text-foreground"]}>
              {f.name} · {f.line}
            </a>
          ) : (
            <span class="inline-flex min-h-11 items-center">{f.name} · {f.line}</span>
          ),
        )
      }
    </nav>
    <a href="/" class="inline-flex min-h-11 items-center font-mono text-xs hover:text-foreground sm:hidden">a side project by Ivanka Mendoza ↗</a>
    <!-- Open by default (no JS, wide screens); a script folds it on phones so each tab stays short. -->
    <details class="fold group" id="footer-sources" open>
      <summary class="flex min-h-11 cursor-pointer items-center justify-between font-medium text-foreground sm:hidden">
        Sources <span class="fold-sign font-mono text-primary-strong" aria-hidden="true"></span>
      </summary>
      <p class="leading-relaxed">
        {"Sources: "}
        {sources.map((s, i) => (
          <>
            <a class="underline underline-offset-4 hover:text-foreground" href={s.openUrl ?? s.url}>{s.short}</a> ({licenceShort(s.licence)}){i < sources.length - 1 ? " · " : ". "}
          </>
        ))}
        {` PubChem fetched ${summary.pubchemFetchedAt}, FoodData Central ${summary.fdcFetchedAt}. Code MIT; data CC BY 4.0. `}
        <a class="underline underline-offset-4 hover:text-foreground" href="/sangkap/data/">About the data</a>.
      </p>
    </details>
  </footer>
  <script>
    const d = document.getElementById("footer-sources") as HTMLDetailsElement | null;
    const wide = matchMedia("(min-width: 640px)");
    const sync = () => d && (d.open = wide.matches);
    sync();
    wide.addEventListener("change", sync);
  </script>
</Layout>
