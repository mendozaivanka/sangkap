---
import SangkapLayout from "@/components/sangkap/SangkapLayout.astro";
---

<SangkapLayout title="Page not found">
  <section class="grid gap-4 py-16">
    <p class="label-mono">404</p>
    <h1 class="text-4xl font-bold tracking-[-0.03em]">This page isn't in the cup.</h1>
    <p class="max-w-[52ch] text-muted-foreground">
      The link may be old. Try the <a class="link" href="/sangkap/">overview</a>, the
      <a class="link" href="/sangkap/evidence/">evidence</a>, or go back to <a class="link" href="/">Ivanka's portfolio</a>.
    </p>
  </section>
</SangkapLayout>
